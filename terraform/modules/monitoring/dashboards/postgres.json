{
  "dashboard": {
    "title": "Bookstore - PostgreSQL Clusters",
    "tags": ["bookstore", "postgresql"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Database Connections",
        "type": "graph",
        "targets": [
          {
            "expr": "pg_stat_database_numbackends{namespace=\"bookstore\"}",
            "legendFormat": "{{ cluster }} - {{ datname }}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Query Rate (queries/s)",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(pg_stat_database_xact_commit{namespace=\"bookstore\"}[5m])",
            "legendFormat": "{{ cluster }} - commits/s"
          },
          {
            "expr": "rate(pg_stat_database_xact_rollback{namespace=\"bookstore\"}[5m])",
            "legendFormat": "{{ cluster }} - rollbacks/s"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Replication Lag (seconds)",
        "type": "graph",
        "targets": [
          {
            "expr": "pg_replication_lag{namespace=\"bookstore\"}",
            "legendFormat": "{{ cluster }}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Database Size (GB)",
        "type": "graph",
        "targets": [
          {
            "expr": "pg_database_size_bytes{namespace=\"bookstore\"} / 1024 / 1024 / 1024",
            "legendFormat": "{{ cluster }} - {{ datname }}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 5,
        "title": "Cache Hit Ratio (%)",
        "type": "graph",
        "targets": [
          {
            "expr": "(sum(pg_stat_database_blks_hit{namespace=\"bookstore\"}) / (sum(pg_stat_database_blks_hit{namespace=\"bookstore\"}) + sum(pg_stat_database_blks_read{namespace=\"bookstore\"}))) * 100",
            "legendFormat": "{{ cluster }}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
      },
      {
        "id": 6,
        "title": "Tuple Stats (tuples/s)",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(pg_stat_database_tup_inserted{namespace=\"bookstore\"}[5m])",
            "legendFormat": "{{ cluster }} - inserts"
          },
          {
            "expr": "rate(pg_stat_database_tup_updated{namespace=\"bookstore\"}[5m])",
            "legendFormat": "{{ cluster }} - updates"
          },
          {
            "expr": "rate(pg_stat_database_tup_deleted{namespace=\"bookstore\"}[5m])",
            "legendFormat": "{{ cluster }} - deletes"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
      }
    ]
  }
}
