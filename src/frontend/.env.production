# Production Configuration for Bookstore Frontend
# This file is used during production builds

# Backend API Configuration
VITE_API_URL=https://api.bookstore.example.com
VITE_API_VERSION=v1

# Keycloak Authentication
VITE_KEYCLOAK_URL=https://auth.bookstore.example.com
VITE_KEYCLOAK_REALM=bookstore
VITE_KEYCLOAK_CLIENT_ID=bookstore-frontend

# Application
VITE_APP_NAME=Bookstore

# IMPORTANT: Update these URLs to match your actual deployment
# - API URL should point to your Istio Gateway
# - Keycloak URL should point to your Keycloak instance
