// ==============================================================================
// GRAPH DATABASE - Apache AGE (separate database)
// ==============================================================================
// This uses Apache AGE extension for graph queries
// Connected via GRAPH_DATABASE_URL

/*
Apache AGE Graph Schema (created via Cypher):

Vertex Labels:
- User: { id: UUID, keycloakId: String, name: String }
- Book: { id: UUID, isbn: String, title: String, author: String }

Edge Labels:
- PURCHASED: { userId: UUID, bookId: UUID, date: Timestamp, price: Decimal }
- RATED: { userId: UUID, bookId: UUID, rating: Int, review: String }
- FRIENDS_WITH: { userId1: UUID, userId2: UUID, since: Timestamp }

Example Cypher queries:

-- Get book recommendations based on similar users
MATCH (user:User {id: 'user123'})-[:PURCHASED]->(book:Book)
      <-[:PURCHASED]-(other:User)-[:PURCHASED]->(rec:Book)
WHERE NOT (user)-[:PURCHASED]->(rec)
RETURN rec.title, rec.isbn, COUNT(other) as score
ORDER BY score DESC
LIMIT 10;

-- Find friends who bought similar books
MATCH (user:User {id: 'user123'})-[:FRIENDS_WITH]-(friend:User)
      -[:PURCHASED]->(book:Book)
WHERE NOT (user)-[:PURCHASED]->(book)
